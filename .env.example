# ==============================================================================
# LUMIÈRE HAIR ATELIER - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép tệp này thành `.env`:
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (Windows CMD)
#      Copy-Item .env.example .env (Windows PowerShell)
# 2. Cập nhật các giá trị cấu hình tương ứng với môi trường của bạn (Development / Production).
# 3. Mặc định ở môi trường Local Development, ứng dụng đã cấu hình sẵn Mock Storage
#    và Demo Try-On Engine, có thể chạy ngay lập tức mà không cần tài khoản dịch vụ ngoài.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ỨNG DỤNG & MÔI TRƯỜNG CHẠY (APPLICATION & RUNTIME ENVIRONMENT)
# ------------------------------------------------------------------------------
# Môi trường chạy của ứng dụng: "development" | "test" | "production"
NODE_ENV="development"

# Cổng lắng nghe HTTP cục bộ
PORT=3000

# URL công khai cơ sở của ứng dụng (được Next.js client-side sử dụng)
# - Local: http://localhost:3000
# - Production: https://lumiere-hair.vercel.app hoặc domain riêng của salon
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tên thương hiệu hiển thị trên giao diện người dùng
NEXT_PUBLIC_BRAND_NAME="Công Nguyễn Hair Salon"


# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL & PRISMA ORM
# ------------------------------------------------------------------------------
# Hệ thống sử dụng PostgreSQL kết hợp Prisma ORM.
#
# Đối với môi trường Local:
# Cài đặt PostgreSQL cục bộ hoặc qua Docker:
# docker run --name lumiere-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=lumiere_salon -p 5432:5432 -d postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumiere_salon?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lumiere_salon?schema=public"

# Đối với môi trường Serverless (Vercel + Neon / Supabase / Vercel Postgres):
# - DATABASE_URL: URL kết nối có Connection Pooling (qua PgBouncer, thường là port 6543 hoặc pooler hostname)
#   Ví dụ: postgresql://postgres.xxxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# - DIRECT_URL: URL kết nối trực tiếp đến PostgreSQL (port 5432) để Prisma CLI chạy migration
#   Ví dụ: postgresql://postgres.xxxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres


# ------------------------------------------------------------------------------
# 3. BẢO MẬT XÁC THỰC & PHIÊN LÀM VIỆC (AUTH & SESSION SECURITY)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và mã hóa phiên đăng nhập nhân viên Admin (Tối thiểu 32 ký tự ngẫu nhiên)
# Bạn có thể sinh chuỗi ngẫu nhiên bằng lệnh: `openssl rand -base64 32`
SESSION_SECRET="lumiere_super_secret_session_key_32_characters_minimum_length_required"

# Thời gian sống của cookie phiên đăng nhập Admin tính bằng giây (Mặc định: 604800s = 7 ngày)
SESSION_MAX_AGE_SECONDS=604800

# Cho phép cơ chế Mock Auth trong môi trường Test / Development cục bộ
# CẢNH BÁO AN NINH: BẮT BUỘC đặt thành "false" trên Production để bảo vệ 100% routes /admin
ALLOW_TEST_MOCK_AUTH="false"


# ------------------------------------------------------------------------------
# 4. NHÀ CUNG CẤP LƯU TRỮ ĐA PHƯƠNG TIỆN (PLUGGABLE CLOUD STORAGE)
# ------------------------------------------------------------------------------
# Hệ thống hỗ trợ thiết kế trừu tượng StorageProvider, không lưu file trên disk của serverless container.
# Tùy chọn provider:
#   - "mock": Sử dụng mock provider nội bộ (phù hợp local test & demo)
#   - "cloudinary": Sử dụng Cloudinary Media Cloud (khuyên dùng cho production)
#   - "supabase": Sử dụng Supabase Storage bucket
STORAGE_PROVIDER="mock"

# Khi STORAGE_PROVIDER="mock", tùy chọn ghi bản sao file vào thư mục public/uploads/ để xem trước cục bộ
STORAGE_SAVE_LOCAL_DISK="true"

# Cấu hình Cloudinary (Bắt buộc nếu STORAGE_PROVIDER="cloudinary")
# Đăng ký tài khoản miễn phí tại: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lumiere-salon"

# Cấu hình Supabase Storage (Bắt buộc nếu STORAGE_PROVIDER="supabase")
# Lấy từ Project Settings -> API & Storage trên Supabase dashboard
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lumiere-media"


# ------------------------------------------------------------------------------
# 5. CÔNG CỤ THỬ TÓC TRỰC QUAN & BẢO MẬT SINH TRẮC HỌC (HAIR TRY-ON ENGINE)
# ------------------------------------------------------------------------------
# Kiến trúc HairTryOnProvider độc lập, xử lý ảnh trong RAM (in-memory buffer), zero-disk persistence.
# Tùy chọn engine:
#   - "demo": Bộ mô phỏng DemoHairTryOnProvider tạo composite SVG preview chuẩn nhận diện
#   - "replicate": Tích hợp AI Image Generative API qua Replicate / Stable Diffusion
TRYON_PROVIDER="demo"

# Giả lập độ trễ xử lý của Demo Provider (mili-giây) tạo cảm giác AI đang phân tích
TRYON_MIN_DELAY_MS=1500
TRYON_MAX_DELAY_MS=2000

# Thời gian chờ tối đa cho 1 yêu cầu mô phỏng trước khi timeout (mili-giây, mặc định 15000ms = 15s)
TRYON_TIMEOUT_MS=15000

# Khóa API AI bên thứ ba (Chỉ dùng khi nâng cấp lên AI Engine thực tế, TUYỆT ĐỐI KHÔNG để lộ ra client)
AI_TRYON_API_KEY=""


# ------------------------------------------------------------------------------
# 6. GIỚI HẠN DUNG LƯỢNG & TẢI TỆP (UPLOAD BOUNDARIES & SECURITY)
# ------------------------------------------------------------------------------
# Dung lượng tối đa của một tệp tải lên tính bằng byte (Mặc định: 5242880 bytes = 5.0 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Danh sách định dạng ảnh hợp lệ (Phân cách bởi dấu phẩy, kiểm tra kết hợp Content-Type & Magic Bytes)
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
